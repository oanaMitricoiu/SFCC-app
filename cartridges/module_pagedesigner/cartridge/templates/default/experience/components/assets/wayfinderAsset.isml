<isdecorate template="${pdict.decorator}">
    <isscript>
    var assets = require('*/cartridge/scripts/assets.js');
    assets.addCss('/css/wayfinderasset.css')
    </isscript>

    <div class="wayfinder-container">
        <figure>
        
            <picture>
                <source srcset="${pdict.image.src.desktop}" media="(min-width: 768px)">
                <a href="${URLUtils.url('Search-Show', 'q', pdict.categoryName)}">
                <img class="wayfinder-image" src="${pdict.image.src.mobile}"
                    style="--focal-point-x:${pdict.image.focalPointX}; --focal-point-y:${pdict.image.focalPointY}" <isif
                    condition="${pdict.image.alt}">alt="${pdict.image.alt}" title="${pdict.image.alt}"</isif> />
                </a>
            </picture>
        
            <figcaption class="category-text_container" <isif condition="${pdict.text_alignment === 'center'}">
                style="text-align:
                center"</isif>>
                <div class="category-text_heading">
                    <span class="category-text category-text_heading">
                        <isprint value="${pdict.text_headline}" /></span>
                </div>
            </figcaption>
        </figure>
    </div>
</isdecorate>

