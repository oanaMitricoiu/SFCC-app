<?xml version="1.0" encoding="UTF-8"?>
<jobs xmlns="http://www.demandware.com/xml/impex/jobs/2015-07-01">
    <job job-id="TestJob">
        <description>Hello World</description>
        <parameters/>
        <flow>
            <context site-id="Sites"/>
            <step step-id="TestJob" type="ExecuteScriptModule" enforce-restart="false">
                <description>Test Job logging Hello World</description>
                <parameters>
                    <parameter name="ExecuteScriptModule.Module">app_storefront_custom/cartridge/scripts/job/TestJobModule.js</parameter>
                    <parameter name="ExecuteScriptModule.FunctionName">execute</parameter>
                    <parameter name="ExecuteScriptModule.Transactional">false</parameter>
                    <parameter name="firstParam">Hello World</parameter>
                    <parameter name="secondParam">From</parameter>
                </parameters>
            </step>
        </flow>
        <rules/>
        <triggers>
            <run-once enabled="false">
                <date>2024-09-30Z</date>
                <time>04:54:00.000Z</time>
            </run-once>
        </triggers>
    </job>

    <job job-id="CategoryAssignment">
        <description>Takes products that have a certain brand and assigns them to a category .</description>
        <parameters/>
        <flow>
            <context site-id="RefArch"/>
            <step step-id="CategoryAssignment" type="ExecuteScriptModule" enforce-restart="false">
                <description>Takes all products that have a certain brand and assigns them to a category</description>
                <parameters>
                    <parameter name="ExecuteScriptModule.Module">app_training/cartridge/scripts/category/assignCategory.js</parameter>
                    <parameter name="ExecuteScriptModule.FunctionName">execute</parameter>
                    <parameter name="ExecuteScriptModule.Transactional">false</parameter>
                    <parameter name="brand">pencil</parameter>
                </parameters>
            </step>
        </flow>
        <rules/>
        <triggers>
            <run-once enabled="false">
                <date>2024-10-01Z</date>
                <time>07:03:00.000Z</time>
            </run-once>
        </triggers>
    </job>

    <job job-id="CustomerOrders">
        <description>creates  a CSV file that contains all orders placed by customers.</description>
        <parameters/>
        <flow>
            <context site-id="RefArch"/>
            <step step-id="RetrieveOrders" type="ExecuteScriptModule" enforce-restart="false">
                <description>retrieves all all orders placed by customers</description>
                <parameters>
                    <parameter name="ExecuteScriptModule.Module">app_training/cartridge/scripts/job/generateOrdersReport.js</parameter>
                    <parameter name="ExecuteScriptModule.FunctionName">execute</parameter>
                    <parameter name="ExecuteScriptModule.Transactional">false</parameter>
                </parameters>
            </step>
        </flow>
        <rules/>
        <triggers>
            <run-once enabled="false">
                <date>2024-09-30Z</date>
                <time>21:04:00.000Z</time>
                <rules>
                    <on-exit status="ERROR">
                        <disable-trigger/>
                    </on-exit>
                </rules>
            </run-once>
        </triggers>
    </job>

    <job job-id="RebuildURLs">
        <description/>
        <parameters/>
        <split sequential="false">
            <contexts template-ref="template_40">
                <context site-id="RefArch"/>
                <context site-id="RefArchGlobal"/>
            </contexts>
            <flow-template template-id="template_40">
                <step step-id="RebuildURLs" type="UpdateStorefrontURLs" enforce-restart="false">
                    <description/>
                    <parameters/>
                </step>
            </flow-template>
        </split>
        <rules/>
        <triggers>
            <run-once enabled="false">
                <date>2018-06-25Z</date>
                <time>05:38:00.000Z</time>
            </run-once>
        </triggers>
    </job>

    <job job-id="Reindex">
        <description/>
        <parameters/>
        <split sequential="false">
            <contexts template-ref="template_45">
                <context site-id="RefArch"/>
                <context site-id="RefArchGlobal"/>
            </contexts>
            <flow-template template-id="template_45">
                <step step-id="Reindex" type="SearchReindex" enforce-restart="false">
                    <description/>
                    <parameters>
                        <parameter name="Product related search indexes">true</parameter>
                        <parameter name="Active data search index">true</parameter>
                        <parameter name="Content search index">true</parameter>
                        <parameter name="Indexer Type">Full Index Rebuild</parameter>
                    </parameters>
                </step>
            </flow-template>
        </split>
        <rules/>
        <triggers>
            <run-once enabled="false">
                <date>2018-06-25Z</date>
                <time>05:36:00.000Z</time>
            </run-once>
        </triggers>
    </job>

</jobs>
